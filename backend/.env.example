# Copy to .env. NEVER commit a filled .env. Never log any secret below.
# Required to run hosted: DATABASE_URL, KEEPER_SECRET_KEY, ORACLE_SECRET_KEY,
# GAS_SECRET_KEY (three different keys), WALLET_ENCRYPTION_KEY and
# TELEGRAM_BOT_TOKEN. Everything else has a default or is optional
# (blank = disabled/default, e.g. GEMINI_API_KEY/LLM_MODEL, MINIAPP_*).
PORT=3002
DATABASE_URL=postgresql://mac@localhost:5432/pacer_dev
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON arrays of 64 bytes, e.g. [12,34,...]. Keeper != oracle != gas.
KEEPER_SECRET_KEY=
ORACLE_SECRET_KEY=
GAS_SECRET_KEY=
WALLET_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
# Gemini intent parsing. No default model: if either is blank the LLM is
# disabled and the deterministic parser handles every message.
GEMINI_API_KEY=
LLM_MODEL=
JUPITER_API_KEY=
MAINNET_PRICE_MINTS=XsbEhLAtcf6HdfpFZ5xEMdqW8nfAvcsP5bdudRLJzJp,Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh,XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W
# Demo tuning (SPEC): production period 86400 / min_trade 1000000.
PERIOD_SECONDS=86400
MIN_TRADE_MICRO_USDC=1000000
MAX_SLIPPAGE_BPS=100
MAX_PRICE_AGE_SECS=600
# Demo only: republish last good price so freshness checks don't block judging.
DEMO_REPUBLISH=false
# Mini App: page URL for the bot's "Open the comparison" button, and the
# comma-separated origins allowed to call the API (blank = no button / no CORS).
MINIAPP_URL=
MINIAPP_ORIGIN=
HISTORY_DIR=
# Weekly summary schedule override (cron syntax). Default: Mondays 09:00.
SUMMARY_CRON=
# Stage-3 gate script (scripts/verify-devnet.mjs) — real IDL only.
VAULT_IDL_PATH=
VAULT_PROGRAM_ID=
OWNER_SECRET_KEY=
WITHDRAWAL_ADDRESS=
USDC_MINT=
STOCK_MINT=
DEPOSIT_MICRO_USDC=10000000
RATE_MICRO_USDC=500000
PRICE_MICRO_USDC=336470000
PERIOD_WAIT_SECONDS=25
